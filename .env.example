# GV YouTube Tag Generator Environment Configuration
# Copy this file to .env and customize as needed.

# Server Configuration
PORT=3001
NODE_ENV=development

# Brand and Domain Settings (Configurable)
VITE_APP_BRAND_NAME="GV YouTube Tag Generator"
VITE_APP_BRAND_INITIALS="GV"
VITE_APP_CANONICAL_URL="https://gv-taggenerator.web.app"

# Rate Limiting Configuration (Server side)
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes in ms
RATE_LIMIT_MAX_REQUESTS=60   # Max requests per IP per window

# Optional AI API Provider Configuration (Server side only - NEVER expose on frontend)
# Supported options: GEMINI or OPENAI_COMPATIBLE
AI_PROVIDER=GEMINI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI / Compatible Provider (e.g. Groq, OpenRouter, Mistral, Local Ollama)
# AI_PROVIDER=OPENAI_COMPATIBLE
# OPENAI_API_KEY=your_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
